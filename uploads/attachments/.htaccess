# Supporting documents are medical certificates. Nothing in this directory may
# be served directly: the only route to a file is modules/leave/attachment.php,
# which checks that the person asking is the applicant or one of their approvers.
#
# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Nginx does not read .htaccess. Add this to the server block instead:
#   location ^~ /uploads/ { deny all; }
